parameters:
    level: max
    paths:
        - .
    bootstrapFiles:
        - ../vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - ../vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - ../easy-digital-downloads-stubs.php
    ignoreErrors:
        # Tests verify class existence / inheritance — PHPStan knows these are true
        # because stubs are loaded, but the tests validate runtime behavior.
        - identifier: method.alreadyNarrowedType
          path: StubSyntaxTest.php
        - identifier: function.alreadyNarrowedType
          path: StubSyntaxTest.php
